{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.1",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/BeAPI/blockparty-button-icon",
				"ref": "1.0.0",
				"refType": "tag"
			},
			"options": {
				"activate": true,
				"targetFolderName": "blockparty-button-icon"
			}
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		}
	]
}
