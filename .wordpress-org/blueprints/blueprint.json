{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/blockparty-button-icon-demo/",
	"preferredVersions": {
		"php": "8.1",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/BeAPI/blockparty-button-icon",
				"ref": "playground/blueprint-preview",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "blockparty-button-icon"
			}
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once 'wordpress/wp-load.php';\nrequire_once WP_PLUGIN_DIR . '/blockparty-button-icon/.wordpress-org/blueprints/bootstrap-playground.php';\n?>"
		}
	]
}
