<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 name="Blockparty Button Icon"
		 xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>Coding Standard for Blockparty Button Icon plugin</description>

	<file>blockparty-button-icon.php</file>
	<file>classes</file>

	<exclude-pattern>./build/</exclude-pattern>
	<exclude-pattern>./node_modules/</exclude-pattern>
	<exclude-pattern>./src/</exclude-pattern>
	<exclude-pattern>./tests/bin/</exclude-pattern>
	<exclude-pattern>./vendor/</exclude-pattern>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
		<exclude name="WordPress.PHP.DisallowShortTernary.Found"/>
	</rule>

	<config name="minimum_supported_wp_version" value="7.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blockparty-button-icon"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.1-"/>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg value="p"/>
	<arg name="colors"/>

	<ini name="memory_limit" value="512M"/>
	<ini name="max_execution_time" value="-1"/>
</ruleset>
