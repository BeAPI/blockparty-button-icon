{
  "name": "beapi/blockparty-button-icon",
  "description": "Easily add icons to button blocks in WordPress.",
  "type": "wordpress-plugin",
  "keywords": ["wordpress", "plugin", "button", "icon", "gutenberg"],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "BeAPI",
      "email": "technique@beapi.fr"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true
    },
    "platform": {
      "php": "8.1.99"
    }
  },
  "autoload": {
    "psr-4": {
      "Blockparty\\ButtonIcon\\": "classes/"
    }
  },
  "require": {
    "php": "^8.1",
    "composer/installers": "^1.0 || ^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "cs": "./vendor/bin/phpcs",
    "cb": "./vendor/bin/phpcbf"
  },
  "scripts-descriptions": {
    "cs": "Run PHP CodeSniffer on codebase using custom ruleset.",
    "cb": "Run PHP Code Beautifier and Fixer on codebase using custom ruleset."
  }
}
